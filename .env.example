# -----------------------------------------------------------------------------
# Frontend Client Firebase Configuration
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# -----------------------------------------------------------------------------
# Express Ingestion Server & Firebase Admin Configuration (Phase 9)
# -----------------------------------------------------------------------------
PORT=3001

# Secret authentication token required for devices uploading to POST /api/sensors/reading
DEVICE_AUTH_TOKEN="pantry-device-token-secret-2026"

# Default user UID for single-tenant / local deployments
PANTRY_USER_ID=jXg9Xh8j0vWwQ2eQeR9qK7aBcD4

# Optional JSON map binding specific hardware deviceIds to authorized user UIDs
# Example: {"device-01":"user_abc123","device-02":"user_def456"}
DEVICE_USER_MAPPINGS={"device-01":"your-firebase-auth-uid"}

# Firebase Project ID for Firestore Admin
FIREBASE_PROJECT_ID=your-project-id

# Path to the Google Cloud / Firebase Admin Service Account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./pantry-c7377-firebase-adminsdk-fbsvc-1c1640d629.json

# Alternatively, set the raw JSON or base64-encoded Service Account Key as an environment string:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id",...}

# Google Application Default Credentials path (optional alternative to above):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Persistence Mode: 'firestore' (default) or 'memory' (for local unit testing without cloud credentials)
FIRESTORE_PERSISTENCE_MODE=firestore

# Optional: When running against local Firebase Firestore emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# -----------------------------------------------------------------------------
# Sensor Simulator & Microservices
# -----------------------------------------------------------------------------
INGESTION_URL=http://localhost:3001/api/sensors/reading
VITE_ML_SERVICE_URL=http://localhost:8000/predict/depletion

# -----------------------------------------------------------------------------
# Google Gemini AI Pantry Assistant Configuration (Phase 10)
# -----------------------------------------------------------------------------
# Server-side Gemini API key (never expose in client or VITE_ prefix!)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Flash-class model identifier
GEMINI_MODEL=gemini-2.5-flash

